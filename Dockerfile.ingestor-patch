FROM nvcr.io/nvidia/blueprint/ingestor-server:2.4.0

# Install poppler-utils — system dependency for pdf2image (provides pdftoppm).
# Required by DocumentClassifierRouter to rasterise PDF pages for nemoretriever-parse
# Pass 1 (detection_only) image-based classification.
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages.
# beautifulsoup4 — used by SimpleWebCrawler for HTML parsing.
# pdf2image      — rasterises PDF pages to PIL images for nemoretriever-parse classifier.
COPY --from=ghcr.io/astral-sh/uv:0.8.12 /uv /tmp/uv
RUN /tmp/uv pip install --python /workspace/.venv/bin/python \
      --no-cache beautifulsoup4 pdf2image && rm /tmp/uv

# Overlay changed source files onto the installed package
COPY src/nvidia_rag/ingestor_server/server.py \
     /workspace/.venv/lib/python3.13/site-packages/nvidia_rag/ingestor_server/server.py
COPY src/nvidia_rag/ingestor_server/main.py \
     /workspace/.venv/lib/python3.13/site-packages/nvidia_rag/ingestor_server/main.py
COPY src/nvidia_rag/ingestor_server/document_classifier_router.py \
     /workspace/.venv/lib/python3.13/site-packages/nvidia_rag/ingestor_server/document_classifier_router.py
COPY src/nvidia_rag/utils/configuration.py \
     /workspace/.venv/lib/python3.13/site-packages/nvidia_rag/utils/configuration.py
COPY src/nvidia_rag/utils/metadata_validation.py \
     /workspace/.venv/lib/python3.13/site-packages/nvidia_rag/utils/metadata_validation.py
COPY src/nvidia_rag/utils/web_crawler.py \
     /workspace/.venv/lib/python3.13/site-packages/nvidia_rag/utils/web_crawler.py
